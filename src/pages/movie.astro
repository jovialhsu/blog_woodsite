---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

// 定義類型
interface ShowInfo {
  time: string;
  onSales: string;
  price: string;
  location: string;
  locationName: string;
}

interface Movie {
  UID: string;
  masterUnit: string;
  showInfo: ShowInfo[];
  title: string;
  descriptionFilterHtml: string;
  sourceWebPromote: string;
  webSales: string;
}

interface MovieWithTag extends Movie {
  id: number;
  tag: string;
}

// 獲取文化部電影展覽資料
async function getMovieData(): Promise<Movie[]> {
  try {
    const response = await fetch(
      'https://cloud.culture.tw/frontsite/trans/SearchShowAction.do?method=doFindTypeJ&category=8'
    );
    const data = await response.json();
    return data as Movie[];
  } catch (error) {
    console.error('獲取電影資料失敗:', error);
    return [];
  }
}

// 處理資料並按縣市分組
const movieData = await getMovieData();
const groupedMovies: Record<string, MovieWithTag[]> = {};

movieData.forEach((movie: Movie, index: number) => {
  if (movie.showInfo && movie.showInfo.length > 0) {
    const location = movie.showInfo[0].location?.trim();
    if (location) {
      const tag = location.slice(0, 3); // 取前三個字作為縣市標籤
      if (!isNaN(Number(tag))) return; // 跳過數字開頭的地址
      
      if (!groupedMovies[tag]) {
        groupedMovies[tag] = [];
      }
      groupedMovies[tag].push({
        id: index,
        ...movie,
        tag
      });
    }
  }
});

// 將分組資料轉換為陣列並排序
const movieGroups = Object.entries(groupedMovies)
  .map(([tag, movies]: [string, MovieWithTag[]]) => ({
    tag,
    count: movies.length,
    movies
  }))
  .sort((a, b) => a.tag.localeCompare(b.tag));
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead title="展覽電影縣市一覽 - {SITE_TITLE}" description="查看全台各縣市的展覽電影資訊" />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 800px;
				margin: 0 auto;
				padding: 2em 1em;
			}
			
			.movie-page h1 {
				text-align: center;
				font-size: 2.5rem;
				margin-bottom: 2em;
				color: rgb(var(--gray-dark));
			}
			
			.tags {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 1rem;
				list-style: none;
				padding: 0;
				margin: 2em 0;
			}
			
			.tag-item {
				background: white;
				border-radius: 8px;
				box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			
			.tag-item:hover {
				transform: translateY(-2px);
				box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
			}
			
			.tag-link {
				display: block;
				padding: 1.5em;
				text-decoration: none;
				color: rgb(var(--gray-dark));
			}
			
			.tag-name {
				font-size: 1.2rem;
				font-weight: bold;
				margin-bottom: 0.5em;
				color: rgb(var(--accent));
			}
			
			.tag-count {
				font-size: 0.9rem;
				color: rgb(var(--gray));
			}
			
			.source-link {
				text-align: center;
				margin-top: 3em;
				padding: 1em;
				background: #f8f9fa;
				border-radius: 8px;
			}
			
			.source-link a {
				color: rgb(var(--accent));
				text-decoration: none;
			}
			
			.source-link a:hover {
				text-decoration: underline;
			}
			
			@media (max-width: 640px) {
				.tags {
					grid-template-columns: 1fr;
				}
				
				.movie-page h1 {
					font-size: 2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="movie-page">
				<h1>🎬 展覽電影縣市一覽</h1>
				
				<ul class="tags">
					{movieGroups.map(group => (
						<li class="tag-item">
							<a href={`/movie/${group.tag}/`} class="tag-link">
								<div class="tag-name">➢ {group.tag}</div>
								<div class="tag-count">({group.count} 個展覽)</div>
							</a>
						</li>
					))}
				</ul>
				
				<div class="source-link">
					<a 
						href="https://cloud.culture.tw/frontsite/trans/SearchShowAction.do?method=doFindTypeJ&category=8"
						target="_blank"
						rel="noopener noreferrer"
					>
						📊 資料來源：文化部 OpenData
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html> 