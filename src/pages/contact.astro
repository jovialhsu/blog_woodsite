---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead title="聯絡我們 - {SITE_TITLE}" description="有任何問題或建議，歡迎與我們聯絡。" />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 800px;
				margin: 0 auto;
				padding: 2em 1em;
			}
			.contact-form {
				background: #f9f9f9;
				padding: 2em;
				border-radius: 8px;
				margin: 2em 0;
			}
			.form-group {
				margin-bottom: 1.5em;
			}
			label {
				display: block;
				margin-bottom: 0.5em;
				font-weight: bold;
				color: rgb(var(--gray-dark));
			}
			input, textarea {
				width: 100%;
				padding: 0.75em;
				border: 1px solid #ddd;
				border-radius: 4px;
				font-size: 1em;
				font-family: inherit;
				box-sizing: border-box;
			}
			input:focus, textarea:focus {
				outline: none;
				border-color: rgb(var(--accent));
				box-shadow: 0 0 0 2px rgba(var(--accent), 0.2);
			}
			textarea {
				min-height: 120px;
				resize: vertical;
			}
			.submit-btn {
				background: rgb(var(--accent));
				color: white;
				padding: 0.75em 2em;
				border: none;
				border-radius: 4px;
				font-size: 1em;
				cursor: pointer;
				transition: background-color 0.2s;
			}
			.submit-btn:hover {
				background: rgb(var(--accent-dark));
			}
			.required {
				color: #e74c3c;
			}
			.form-note {
				font-size: 0.9em;
				color: rgb(var(--gray));
				margin-top: 1em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>聯絡我們</h1>
			<p>有任何問題、建議或想法，歡迎透過以下表單與我們聯絡。我們會盡快回覆您的訊息。</p>
			
			<form 
				name="contact" 
				method="POST" 
				data-netlify="true" 
				netlify-honeypot="bot-field"
				action="/contact-success"
				class="contact-form"
			>
				<!-- Netlify 表單識別 -->
				<input type="hidden" name="form-name" value="contact" />
				
				<!-- 蜜罐字段防止垃圾郵件 -->
				<p style="display: none;">
					<label>Don't fill this out if you're human: <input name="bot-field" /></label>
				</p>
				
				<div class="form-group">
					<label for="name">姓名 <span class="required">*</span></label>
					<input type="text" id="name" name="name" required />
				</div>
				
				<div class="form-group">
					<label for="email">電子郵件 <span class="required">*</span></label>
					<input type="email" id="email" name="email" required />
				</div>
				
				<div class="form-group">
					<label for="subject">主旨</label>
					<input type="text" id="subject" name="subject" />
				</div>
				
				<div class="form-group">
					<label for="message">訊息內容 <span class="required">*</span></label>
					<textarea id="message" name="message" placeholder="請輸入您的訊息..." required></textarea>
				</div>
				
				<button type="submit" class="submit-btn">送出訊息</button>
				
				<p class="form-note">
					<span class="required">*</span> 為必填欄位
				</p>
			</form>
			
			<div style="margin-top: 3em;">
				<h2>其他聯絡方式</h2>
				<p>您也可以透過以下方式與我們聯絡：</p>
				<ul>
					<li>電子郵件：<a href="mailto:celia0528@gmail.com">celia0528@gmail.com</a></li>
					<li>或者在我們的社群媒體上留言</li>
				</ul>
			</div>
		</main>
		<Footer />
	</body>
</html> 