---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

// 定義類型
interface ShowInfo {
  time: string;
  onSales: string;
  price: string;
  location: string;
  locationName: string;
}

interface Movie {
  UID: string;
  masterUnit: string;
  showInfo: ShowInfo[];
  title: string;
  descriptionFilterHtml: string;
  sourceWebPromote: string;
  webSales: string;
}

interface MovieWithTag extends Movie {
  id: number;
  tag: string;
}

export async function getStaticPaths() {
  // 獲取電影資料
  async function getMovieData(): Promise<Movie[]> {
    try {
      const response = await fetch(
        'https://cloud.culture.tw/frontsite/trans/SearchShowAction.do?method=doFindTypeJ&category=8'
      );
      const data = await response.json();
      return data as Movie[];
    } catch (error) {
      console.error('獲取電影資料失敗:', error);
      return [];
    }
  }

  const movieData = await getMovieData();
  const groupedMovies: Record<string, MovieWithTag[]> = {};

  movieData.forEach((movie: Movie, index: number) => {
    if (movie.showInfo && movie.showInfo.length > 0) {
      const location = movie.showInfo[0].location?.trim();
      if (location) {
        const tag = location.slice(0, 3);
        if (!isNaN(Number(tag))) return;
        
        if (!groupedMovies[tag]) {
          groupedMovies[tag] = [];
        }
        groupedMovies[tag].push({
          id: index,
          ...movie,
          tag
        });
      }
    }
  });

  return Object.entries(groupedMovies).map(([tag, movies]) => ({
    params: { tag },
    props: { movies, tag }
  }));
}

interface Props {
  movies: MovieWithTag[];
  tag: string;
}

const { movies, tag } = Astro.props as Props;

// 按時間排序電影
const sortedMovies = movies.sort((a, b) => {
  const timeA = a.showInfo[0]?.time || '';
  const timeB = b.showInfo[0]?.time || '';
  return timeA.localeCompare(timeB);
});
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead title="{tag}展覽電影一覽 - {SITE_TITLE}" description="{tag}地區的展覽電影資訊" />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 900px;
				margin: 0 auto;
				padding: 2em 1em;
			}
			
			.movie-page h1 {
				text-align: center;
				font-size: 2.5rem;
				margin-bottom: 2em;
				color: rgb(var(--gray-dark));
			}
			
			.movie-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				gap: 2rem;
			}
			
			.movie-item {
				background: white;
				border-radius: 12px;
				padding: 2em;
				box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			
			.movie-item:hover {
				transform: translateY(-2px);
				box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
			}
			
			.movie-header {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				margin-bottom: 1em;
				gap: 1em;
			}
			
			.movie-title {
				font-size: 1.3rem;
				font-weight: bold;
				color: rgb(var(--gray-dark));
				margin: 0;
				flex: 1;
			}
			
			.movie-meta {
				display: flex;
				gap: 0.5em;
				align-items: center;
				flex-shrink: 0;
			}
			
			.movie-time {
				background: rgb(var(--accent));
				color: rgb(var(--gray-dark));
				padding: 0.25em 0.75em;
				border-radius: 20px;
				/* font-size: 0.9rem; */
			}
			.movie-info {
				display: flex;
                align-items: center;
				/* flex-direction: column; */
				gap: 0.5em;
			}
			.sale-icon {
				font-size: 1.2rem;
				cursor: pointer;
			}
			
			.location-info {
				margin: 1em 0;
                font-size: 1rem;
				font-weight: bold;
				color: rgb(var(--accent));
			}
			
			.address {
				margin: 0.5em 0;
                font-size: 1rem;
				/* font-size: 0.95rem; */
				color: rgb(var(--gray));
				display: flex;
				align-items: flex-start;
				gap: 0.5em;
			}
			
			.description {
				margin-top: 1em;
				font-size: 0.95rem;
				color: rgb(var(--gray));
				line-height: 1.6;
			}
			
			.description-list {
				margin: 0.5em 0;
				padding-left: 1.5em;
			}
			
			.description-list li {
				margin-bottom: 0.5em;
			}
			
			.back-link {
				display: inline-block;
				margin-top: 3em;
				padding: 0.75em 1.5em;
				background: rgb(var(--accent));
				color: white;
				text-decoration: none;
				border-radius: 8px;
				transition: background-color 0.2s;
			}
			
			.back-link:hover {
				background: rgb(var(--accent-dark));
			}
			
			@media (max-width: 640px) {
				.movie-header {
					flex-direction: column;
					align-items: flex-start;
				}
				
				.movie-meta {
					order: -1;
				}
				
				.movie-page h1 {
					font-size: 2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="movie-page">
				<h1>✨ {tag}展覽電影一覽</h1>
				
				<ul class="movie-list">
					{sortedMovies.map(movie => {
                        console.log(movie)
                        return (
						<li class="movie-item">
							<div class="movie-header">
								<h2 class="movie-title">{movie.title}</h2>
								<div class="movie-meta">
									
									{movie.showInfo[0]?.onSales === 'Y' && (
										movie.webSales ? (
											<a 
												href={movie.webSales} 
												target="_blank" 
												rel="noopener noreferrer"
												title={movie.showInfo[0]?.price || '售票資訊'}
												class="sale-icon"
											>
												💲
											</a>
										) : (
											<span 
												title={movie.showInfo[0]?.price || '售票資訊'}
												class="sale-icon"
											>
												💲
											</span>
										)
									)}
								</div>
							</div>
							
							{movie.showInfo && movie.showInfo.map(showInfo => (
                                <span class="movie-time">{showInfo?.time}</span>
                                <div class="movie-info">
								<div class="location-info">
									📍 【{showInfo?.locationName}】
								</div>
                                <div class="address">
									<span>🏢</span>
									<span>地址：{showInfo?.location}</span>
								</div></div>
                                
							))}
							
							
							
							{movie.descriptionFilterHtml && (
								<div class="description">
									<span>🎬</span>
									<strong>詳情：</strong>
									<ul class="description-list">
										{movie.descriptionFilterHtml
											.split(/\r\n|\r|\n/) // 處理各種換行符號
											.filter(item => item.trim()) // 過濾空行
											.map(item => (
												<li>{item.trim()}</li>
											))
										}
									</ul>
								</div>
							)}
						</li>
					)})}
				</ul>
				
				<a href="/movie" class="back-link">
					🎬 看全部縣市
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html> 