---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="404 - 頁面未找到" description="抱歉，您要找的頁面不存在。" />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
				text-align: center;
				padding: 2em 0;
			}
			.error-content {
				max-width: 600px;
				margin: 0 auto;
				padding: 2em;
			}
			.error-code {
				font-size: 6rem;
				font-weight: bold;
				color: rgb(var(--accent));
				margin: 0;
			}
			.error-message {
				font-size: 1.5rem;
				margin: 1em 0;
				color: rgb(var(--gray-dark));
			}
			.error-description {
				margin: 1em 0;
				color: rgb(var(--gray));
			}
			.back-link {
				display: inline-block;
				margin-top: 2em;
				padding: 0.5em 1em;
				background: rgb(var(--accent));
				color: white;
				text-decoration: none;
				border-radius: 4px;
				transition: background-color 0.2s;
			}
			.back-link:hover {
				background: rgb(var(--accent-dark));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="error-content">
				<h1 class="error-code">404</h1>
				<h2 class="error-message">頁面未找到</h2>
				<p class="error-description">
					抱歉，您要找的頁面不存在。可能是連結已過期，或者頁面已被移動。
				</p>
				<a href="/" class="back-link">回到首頁</a>
			</div>
		</main>
		<Footer />
	</body>
</html> 