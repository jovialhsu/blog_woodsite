---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const categories = [...new Set(posts.map(post => post.data.category))].filter(Boolean);
  
  return categories.map(category => ({
    params: { category },
    props: { category }
  }));
}

const { category } = Astro.props;
const posts = await getCollection('blog', post => post.data.category === category);
---
<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead title={`${category} 分類 - ${SITE_TITLE}`} description={`${category} 分類的所有文章`} />
  </head>
  <body>
    <Header />
    <main>
      <h1>{category} 分類的文章</h1>
      <ul class="posts-list">
        {posts.map(post => (
          <li class="post-item">
            <a href={`/blog/${post.slug}`}>
              {(post.data.heroImage || post.data.image) && (
                <img 
                  class="post-image" 
                  src={post.data.heroImage || post.data.image} 
                  alt={post.data.title}
                />
              )}
              <div class="post-content">
                <h2 class="post-title">{post.data.title}</h2>
                <time class="post-date" datetime={post.data.pubDate?.toISOString()}>
                  <FormattedDate date={post.data.pubDate || post.data.date || new Date()} />
                </time>
                {(post.data.excerpt || post.data.description) && (
                  <p class="post-excerpt">
                    {post.data.excerpt || post.data.description}
                  </p>
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    width: calc(100% - 2em);
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1em;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 2rem;
    text-align: center;
    color: rgb(var(--gray-dark));
  }

  .posts-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 2rem;
  }

  .post-item {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .post-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .post-item a {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.5rem;
    text-decoration: none;
    color: inherit;
    align-items: center;
  }

  .post-image {
    width: 200px;
    height: 150px;
    object-fit: cover;
  }

  .post-content {
    padding: 1.5rem;
  }

  .post-title {
    margin: 0 0 0.5em 0;
    font-size: 1.5rem;
    line-height: 1.3;
    color: rgb(var(--gray-dark));
  }

  .post-date {
    font-size: 0.9rem;
    color: rgb(var(--gray));
  }

  .post-excerpt {
    margin: 0.5em 0 0 0;
    font-size: 0.95rem;
    color: rgb(var(--gray));
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .post-item a {
      grid-template-columns: 1fr;
      text-align: center;
    }
    
    .post-image {
      width: 100%;
      height: 200px;
    }
    
    h1 {
      font-size: 2rem;
    }
  }
</style> 